# -------------------------------------------------------
# AI Negotiation Agent — Environment Variable Template
# -------------------------------------------------------
# Copy this file to .env and fill in the values before
# starting the containers.
# -------------------------------------------------------

# Base URL of the Ollama service reachable from within the API container.
# When running via docker-compose, use the service name as the hostname.
OLLAMA_BASE_URL=http://ollama:11434

# Name of the Ollama model to use for the negotiation agents.
# Must be pre-pulled inside the Ollama container:
#   docker exec -it <ollama-container> ollama pull llama3
OLLAMA_MODEL=llama3

# LLM temperature: 0.0 = deterministic, 1.0 = creative.
# Lower values are recommended for reproducible test runs.
LLM_TEMPERATURE=0.3

# Request timeout in seconds for each call to the Ollama API.
OLLAMA_TIMEOUT=120

# Score threshold above which agreement_reached is set to True (0.0–1.0).
AGREEMENT_THRESHOLD=0.5

# Path (inside the container) where the negotiation log is written.
LOG_FILE_PATH=/app/logs/negotiation_log.json

# Path (inside the container) to the trade positions data file.
TRADE_POSITIONS_PATH=data/trade_positions.json
